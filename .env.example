# ─────────────────────────────────────────────────────────────
# ALFA USER MUSIC — environment template
# Copy to .env locally. On Railway, add these as service variables.
# Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# --- Telegram Bot API (control plane) ---
# From @BotFather. Must be a dedicated bot for this project.
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithRealValue

# --- Telegram MTProto API (playback plane) ---
# From https://my.telegram.org/apps — this is YOUR application identity,
# every user authorizes their own account against it.
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- MongoDB ---
# Use the mongodb+srv:// string from your Atlas cluster (or Railway Mongo service).
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=alfa_user_music

# --- Session encryption ---
# Master key for encrypting MTProto session strings at rest. Minimum 32 chars.
# Generate once with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this key later invalidates every stored session (users must reconnect).
SESSION_ENCRYPTION_KEY=replace-with-a-48-char-random-urlsafe-string

# --- Access control ---
# Comma separated numeric Telegram user IDs allowed to use /stats /users /broadcast /maintenance /health
ADMIN_IDS=

# --- Runtime ---
ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8080
MAX_CONCURRENT_DOWNLOADS=2
PENDING_AUTH_TTL=300
